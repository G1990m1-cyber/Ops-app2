# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Use the "Transaction pooler" connection string from Supabase → Project Settings → Database.
# Locally you can point this at any Postgres, e.g. postgresql://grhotels:grhotels@127.0.0.1:5432/grhotels
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres  # no ?sslmode needed; Supabase hosts get TLS automatically

# ── Payload ──────────────────────────────────────────────────────────────────
# Long random string. Encrypts sessions and API keys. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-me
# Random string used by the admin "Preview" button. Generate with: openssl rand -hex 16
PREVIEW_SECRET=change-me
# Public URL of the site, no trailing slash. On Vercel this is derived automatically if left blank.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Media storage (Supabase Storage, S3 protocol) ────────────────────────────
# Supabase → Project Settings → Storage → S3 access keys. Leave blank locally to store files on disk.
S3_BUCKET=media
S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_REGION=eu-west-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional. Public base URL for the bucket; derived from S3_ENDPOINT for Supabase if left blank.
# MEDIA_PUBLIC_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/object/public/media

# ── Email (form notifications, password resets) ──────────────────────────────
# Option A: Resend (https://resend.com) API key.
RESEND_API_KEY=
# Option B: any SMTP server. Used only if RESEND_API_KEY is blank.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown on outgoing email. The domain must be verified with Resend / your SMTP provider.
EMAIL_FROM_ADDRESS=website@grhotels.co.uk
EMAIL_FROM_NAME=GR Hotels
# Where enquiries go when a hotel has no email set.
# Optional safety net; the normal setting is Site settings → Enquiries in the admin.
ENQUIRY_FALLBACK_EMAIL=info@grhotels.co.uk

# ── Spam protection (Cloudflare Turnstile, free) ─────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Newsletter (HubSpot Forms) ───────────────────────────────────────────────
# Portal ID is the account number shown top right in HubSpot. Form GUID is the long code in the form's URL.
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=
# EU-hosted accounts (app-eu1.hubspot.com) need api-eu1.hsforms.com; leave blank for US-hosted accounts.
HUBSPOT_FORMS_HOST=

# ── Analytics ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GTM_ID=GTM-WVZV4DV8

# ── Seeding ──────────────────────────────────────────────────────────────────
# Credentials for the first admin user created by `pnpm seed`.
SEED_ADMIN_EMAIL=admin@grhotels.co.uk
SEED_ADMIN_PASSWORD=change-me-now
