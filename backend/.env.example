DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production-use-long-random-string"
PORT=3000

# Hostaway API (Settings → API in your Hostaway account)
HOSTAWAY_ACCOUNT_ID="your-account-id"
HOSTAWAY_API_KEY="your-api-key"

# Hostaway webhook secret (set when registering the webhook in Hostaway)
HOSTAWAY_WEBHOOK_SECRET="your-webhook-secret"
